# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server-only: bypasses RLS, used by the form API routes and admin dashboard.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Admin dashboard
ADMIN_PASSWORD=<admin password>

# Email notifications — where every form submission is delivered
NOTIFICATION_EMAIL=tejas.natani@lavivenzia.com
NOTIFICATION_FROM_EMAIL=tejas.natani@lavivenzia.com
NOTIFICATION_FROM_NAME=La Vivenzia

# SMTP transport (nodemailer). Google Workspace needs an App Password,
# not the account password. For AWS SES use:
#   SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587,
#   SMTP_USER/SMTP_PASS = the SES SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: force implicit TLS on a non-465 port
# SMTP_SECURE=true
